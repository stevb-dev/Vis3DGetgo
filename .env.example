# ── Database ─────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=thesis

# ── Auth ─────────────────────────────────────────────────────────
# Generate a real secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false   # set true only when serving over HTTPS

# ── API ──────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_LOCATION=200

# ── Seed (production container start) ────────────────────────────
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
# Demo curator persona: owns the seeded demo locations.
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=Demo123!
