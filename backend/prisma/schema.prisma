generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector]
}

enum Role {
  USER
  ADMIN
}

enum ReportCategory {
  SPAM
  INAPPROPRIATE
  WRONG_LOCATION
  BROKEN
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationType {
  MODERATION_REMOVAL
}

enum LocationCategory {
  MUSEUMS
  ART_GALLERIES
  MONUMENTS
  EDUCATION
  ENTERTAINMENT
  HEALTH
  HOUSING
  STORES
  FINANCE
  FOOD_AND_DRINK
  NATURE
}

enum ModelFormat {
  GLB
  SPZ
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  username      String         @unique
  password      String // bcrypt hash (per-password random salt embedded by bcrypt)
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  locations     Location[]
  images        Image[]
  reports       Report[]
  refreshTokens RefreshToken[]
  savedLocations SavedLocation[]
  // Admin "last seen reports" watermark (report-resolution/06): the unread badge
  // counts OPEN reports created after this instant.
  lastSeenReportsAt DateTime?
  notifications     Notification[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 of the opaque token; raw value only ever lives in the httpOnly cookie
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  userId Int?
  user   User?  @relation(fields: [userId], references: [id])

  // Seeded demo locations are owned by the seed's demo admin account
  // (see prisma/seed.ts) and flagged so the UI can badge them distinctly.
  seeded Boolean @default(false)

  // Fixed category taxonomy (.scratch/sidebar-redesign/issues/01).
  category LocationCategory @default(MONUMENTS)

  // Soft-delete timestamp (report-resolution): moderation hides the row from all
  // queries without hard-deleting, so reports + the audit trail survive.
  deletedAt DateTime?

  // Semantic search embedding (.scratch/search) — multilingual-e5-small (384-dim).
  // Nullable: the degrade path (embedding failure) saves the row unsearchable
  // until the backfill pass re-embeds it.
  embedding Unsupported("vector(384)")?

  // Admin-pinned carousel thumbnail; null falls back to the first image by order.
  // SetNull on image delete, so deleting the pinned image restores the fallback.
  thumbnailImageId Int?   @unique
  thumbnailImage   Image? @relation("LocationThumbnail", fields: [thumbnailImageId], references: [id], onDelete: SetNull)

  model   Model?
  images  Image[]
  reports Report[]
  savedBy SavedLocation[]
}

model Model {
  id         Int      @id @default(autoincrement())
  locationId Int      @unique
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  filename  String // e.g., "eiffel-tower.glb"
  filePath  String // e.g., "/models/eiffel-tower.glb"
  fileSize  Int
  // GLB (Draco mesh) or SPZ (3D Gaussian splat) — drives the viewer's renderer.
  format    ModelFormat
  createdAt DateTime    @default(now())
}

model Image {
  id           Int      @id @default(autoincrement())
  locationId   Int
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename     String // e.g., "uuid.webp"
  originalName String
  filePath     String // e.g., "/uploads/uuid.webp"
  fileSize     Int
  mimeType     String
  order        Int      @default(0) // carousel ordering
  createdAt    DateTime @default(now())
  // Soft-delete timestamp (report-resolution). A location delete cascades this
  // to every child image; the file stays on disk.
  deletedAt    DateTime?

  thumbnailOfLocation Location?  @relation("LocationThumbnail")
  reports             Report[]
}

// A user report about junk content on an Image or a Location. Exactly one
// target must be set (CHECK in the migration); uniqueness per reporter+target
// is enforced by partial unique indexes (also in the migration).
model Report {
  id         Int            @id @default(autoincrement())
  category   ReportCategory
  status     ReportStatus   @default(OPEN)
  imageId    Int?
  image      Image?         @relation(fields: [imageId], references: [id], onDelete: Cascade)
  locationId Int?
  location   Location?      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  closedAt   DateTime?
  note       String?
  createdAt  DateTime       @default(now())
}

// Per-user bookmark of a Location (sidebar-redesign ticket 03).
model SavedLocation {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
}

// Owner notification (report-resolution/08): snapshot of a moderation removal.
// No FK to content — the name/category are copied at removal time so the notice
// survives the content being soft-deleted (or later hard-deleted).
model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  contentName String           // image originalName or location name
  category    ReportCategory?
  note        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
}
